{
  "name": "heyvoices-app",
  "private": true,
  "version": "0.3.0",
  "productName": "HeyVoices",
  "description": "HeyVoices — fully-local AI voice studio (clone, design and generate voices on your own GPU). Built by GeethuDino.",
  "author": "GeethuDino",
  "homepage": "https://pgboyahpgr-commits.github.io/heyvoices/",
  "repository": {
    "type": "git",
    "url": "https://github.com/pgboyahpgr-commits/heyvoices.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n ui,app -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "dev:ui": "vite",
    "dev:backend": "..\\backend\\.venv\\Scripts\\python.exe -m heyvoice",
    "build:ui": "vite build",
    "build": "vite build && electron-builder --win nsis portable",
    "dist:win": "vite build && electron-builder --win nsis portable",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.452.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wavesurfer.js": "^7.8.6",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "sh.heyvoices.studio",
    "productName": "HeyVoices",
    "copyright": "Built by GeethuDino",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.venv/**",
          "!.venv",
          "!**/__pycache__/**",
          "!**/*.log",
          "!models",
          "!models/**",
          "!data",
          "!data/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HeyVoices"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "GeethuDino",
      "synopsis": "Fully-local AI voice studio",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
